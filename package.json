{
  "name": "the-worst-travel",
  "version": "1.0.0",
  "description": "The Worst Travel: juego multijugador de deducción social en tren, barco y avión.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts --dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate:maps": "tsx scripts/validate-maps.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.2.7",
    "@fontsource/nunito": "5.2.7",
    "phaser": "3.90.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
